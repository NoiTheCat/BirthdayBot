<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>4.3.0</Version>
    <Authors>NoiTheCat</Authors>
    <RootNamespace>BirthdayBot</RootNamespace>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <OutputType>Exe</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- for analyzers (code generation) -->
    <AdditionalFiles Include="Localization/Commands.en-US.json" />

    <!-- include translations in output-->
    <Content Include="Localization/Commands.*.json" CopyToOutputDirectory="Always" />
    <Content Include="Localization/Responses.*.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Settings suitable for long-running services -->
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>


  <!-- WHEN UPDATING EF CORE: Don't forget to also run "dotnet tool update (dash dash)local dotnet-ef" -->

  <ItemGroup>
    <ProjectReference Include="../Core/src/NpbCore/NpbCore.csproj" />
    <ProjectReference Include="../Core/src/NpbCore.Config/NpbCore.Config.csproj" />

    <ProjectReference Include="../Core/src/NpbCore.JsonGen/NpbCore.JsonGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NodaTime" Version="3.3.3" />
  </ItemGroup>

</Project>
